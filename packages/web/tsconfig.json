{
  "extends": "../../tsconfig.base.json",
  "include": ["app/**/*", "test/**/*", ".react-router/types/**/*", "vite.config.ts", "react-router.config.ts"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client"]
  }
}
