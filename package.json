{
  "name": "recon",
  "private": true,
  "version": "0.1.0",
  "description": "Collaborative vibecoding platform with context version control",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npx @hexclave/cli dev --config-file ./hexclave.config.ts -- npm run dev:all",
    "dev:all": "npm run dev --workspace @recon/engine & npm run dev --workspace @recon/web",
    "dev:engine": "npm run dev --workspace @recon/engine",
    "dev:web": "npm run dev --workspace @recon/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
